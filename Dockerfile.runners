# Custom n8n runners image with additional Python libraries
# Keep this tag identical to the n8nio/n8n tag in docker-compose.yml.
FROM n8nio/runners:2.49.7

USER root

# The runners image has no apk (n8n removes it), so add packages with the bundled uv.
COPY extras.txt /tmp/extras.txt
RUN cd /opt/runners/task-runner-python && uv pip install --no-cache -r /tmp/extras.txt && rm /tmp/extras.txt

# Switch back to the runner user
USER runner
